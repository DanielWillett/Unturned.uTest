<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <PackageId>Unturned.uTest.Templates</PackageId>
    <PackageVersion>0.0.2</PackageVersion>
    <Title>uTest Templates</Title>
    <Authors>Daniel Willett</Authors>
    <Description>Project templates for uTest, an integration testing platform for Unturned.</Description>

    <PackageTags>Unturned;SDG;unit;integration;testing;tests;modding;plugins;RocketMod;Rocket-Mod;OpenMod;Open-Mod;LDM;Legally-Distinct-Missile;LegallyDistinctMissile;Uncreated</PackageTags>

    <PackageType>Template</PackageType>
    <TargetFrameworks>netstandard2.1;net471</TargetFrameworks>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <NoPackageAnalysis>true</NoPackageAnalysis>

  </PropertyGroup>

  <PropertyGroup>
    <LocalizeTemplates>false</LocalizeTemplates>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.Tasks" Version="*" PrivateAssets="all" IsImplicitlyDefined="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="content\**\*" Pack="true" PackagePath="content"/>
    <Compile Remove="**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="content\uTest\.template.config\icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
